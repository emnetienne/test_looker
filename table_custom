/* Tableau auto-ajusté pour Looker
 * Réduit la taille du texte jusqu'à ce que toutes les lignes tiennent dans la zone, sans scroll. */

looker.plugins.visualizations.add({
  id: "table_autofit",
  label: "Tableau auto-ajusté",
  options: {
    header_color: { type: "string", label: "Couleur de l'en-tête", display: "color", default: "#3653AE", section: "Style", order: 1 },
    header_text_color: { type: "string", label: "Texte de l'en-tête", display: "color", default: "#FFFFFF", section: "Style", order: 2 },
    stripe_color: { type: "string", label: "Lignes alternées", display: "color", default: "#F0F2F1", section: "Style", order: 3 },
    max_font: { type: "number", label: "Taille de texte max (px)", default: 16, section: "Style", order: 4 },
    min_font: { type: "number", label: "Taille de texte min (px)", default: 8, section: "Style", order: 5 },
    wrap_text: { type: "boolean", label: "Retour à la ligne", default: true, section: "Style", order: 6 },
    show_row_numbers: { type: "boolean", label: "Numéros de ligne", default: true, section: "Style", order: 7 }
  },

  create: function (element) {
    element.innerHTML =
      "<style>" +
      "html,body{margin:0;padding:0;overflow:hidden}" +
      ".af-root{box-sizing:border-box;width:100%;height:100%;overflow:hidden;font-family:Roboto,Arial,sans-serif;color:#202124}" +
      ".af-root table{width:100%;border-collapse:collapse}" +
      ".af-root th{text-align:left;font-weight:500;vertical-align:bottom;padding:.45em .7em;line-height:1.35}" +
      ".af-root td{padding:.35em .7em;line-height:1.35;vertical-align:top;border-right:1px solid #DADCE0}" +
      ".af-root td:last-child{border-right:none}" +
      ".af-root .num{text-align:right;font-variant-numeric:tabular-nums}" +
      ".af-root td.idx{color:#5F6368;width:1%}" +
      ".af-root.nowrap td,.af-root.nowrap th{white-space:nowrap}" +
      "</style><div class='af-root'></div>";
    this._root = element.querySelector(".af-root");
  },

  updateAsync: function (data, element, config, queryResponse, details, done) {
    this.clearErrors();
    const root = this._root;
    const opt = function (k, d) { return config[k] === undefined || config[k] === null || config[k] === "" ? d : config[k]; };

    const dims = queryResponse.fields.dimension_like || [];
    const meas = queryResponse.fields.measure_like || [];
    const tcs = queryResponse.fields.table_calculations || [];
    const fields = dims.map(function (f) { return { f: f, num: false }; })
      .concat(meas.concat(tcs).map(function (f) { return { f: f, num: true }; }));

    if (!fields.length) {
      this.addError({ title: "Aucun champ", message: "Ajoutez au moins une dimension ou une mesure." });
      return done();
    }

    const showIdx = opt("show_row_numbers", true);
    const headerBg = opt("header_color", "#3653AE");
    const headerFg = opt("header_text_color", "#FFFFFF");
    const stripe = opt("stripe_color", "#F0F2F1");
    root.className = "af-root" + (opt("wrap_text", true) ? "" : " nowrap");

    const esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); };
    const cellText = function (cell) {
      if (!cell) return "";
      if (cell.rendered !== undefined && cell.rendered !== null) return cell.rendered;
      return cell.value === null || cell.value === undefined ? "" : cell.value;
    };

    let html = "<table><thead><tr>";
    if (showIdx) html += "<th style='background:" + headerBg + "'></th>";
    fields.forEach(function (x) {
      const label = x.f.label_short || x.f.label || x.f.name;
      html += "<th class='" + (x.num ? "num" : "") + "' style='background:" + headerBg + ";color:" + headerFg + "'>" + esc(label) + "</th>";
    });
    html += "</tr></thead><tbody>";
    data.forEach(function (row, i) {
      html += "<tr" + (i % 2 === 1 ? " style='background:" + stripe + "'" : "") + ">";
      if (showIdx) html += "<td class='num idx'>" + (i + 1) + "</td>";
      fields.forEach(function (x) {
        html += "<td class='" + (x.num ? "num" : "") + "'>" + esc(cellText(row[x.f.name])) + "</td>";
      });
      html += "</tr>";
    });
    html += "</tbody></table>";
    root.innerHTML = html;

    const table = root.querySelector("table");
    const H = element.clientHeight;
    const W = element.clientWidth;
    const fits = function (size) {
      root.style.fontSize = size + "px";
      return table.offsetHeight <= H && table.scrollWidth <= W + 1;
    };

    let lo = Number(opt("min_font", 8));
    let hi = Number(opt("max_font", 16));
    if (!fits(hi)) {
      let best = lo;
      while (hi - lo > 0.25) {
        const mid = (lo + hi) / 2;
        if (fits(mid)) { best = mid; lo = mid; } else { hi = mid; }
      }
      root.style.fontSize = best + "px";
    }
    done();
  }
});
